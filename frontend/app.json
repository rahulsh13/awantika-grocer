{
  "expo": {
    "name": "Awantika Grocers",
    "slug": "awantika-grocers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "awantika-grocers",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-image.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3F20"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.awantika.grocers"
    },
    "android": {
      "package": "com.awantika.grocers",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1E3F20"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "NOTIFICATIONS",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1E3F20"
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1E3F20"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Awantika Grocers to access your photos to upload product images.",
          "cameraPermission": "Allow Awantika Grocers to use your camera to take product photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
